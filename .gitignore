# Build artifacts
/bin/
/dist/
/keel
*.out
*.test
coverage.*

# Editor / OS
.DS_Store
.idea/
.vscode/
.lh/

# --- Secrets & credentials: NEVER commit ---
.env
.env.*
!.env.example
auth.json
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
credentials.json
.netrc
.keel/secrets*
secrets.yaml
secrets.yml

# --- Private working docs: local-only, never pushed to the public repo ---
# Assistant working directories (handoffs, code reviews with unpatched findings)
# are how the repo is worked on, not what it ships. Excluded at any depth.
**/.claude/

# Research working notes and the local-history plugin's snapshots. Neither is
# a product.
/_workspace/
**/.lh/

# Generated assistant plugin manifests — regenerated on publish, not source.
**/.claude-plugin/

# Test output (regenerated by `make e2e-visible` on every run)
/features/e2e/artifacts/

# Demo-recording work products: regenerated from docs/media/keel-demo.tape, and
# large. The screenshots that are actually referenced by the docs stay tracked.
/docs/media/_*
/docs/media/*.mp4
/docs/media/*.gif
/docs/media/frame_*.png
/docs/media/e2e-*.png
/docs/media/s[0-9]*.png
/docs/media/studio-home.png

# Local scratch / test scaffolds
/keeltest*/
/.cache/
/tmp/
*.local

# Python bytecode from bundled skill scripts
__pycache__/
*.pyc

# Extensions (browser, VS Code, sonar) are their own repositories and never ship
# inside the keel core repo.
/extensions/

# Design/planning docs and the docs site are not part of what keel ships — the
# README is the documentation.
/docs/
/mkdocs.yml
